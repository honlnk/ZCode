<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        android:theme="@style/Theme.Zcodemobile">
        <service
            android:name=".remote.RemoteControlKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Bugfix: 不设 windowSoftInputMode 时系统解析为 adjustPan（dumpsys 实证 sim={adjust=pan}），
             WebView 永远全屏不随键盘缩放、键盘直接盖住页面底部，Chromium 的可视区/光标滚动计算
             与真实情况不一致，导致每次选词上屏或移动光标页面整体上跳 ~550px（约 200ms 滚动动画），
             弹/收键盘时还会触发 ~850px 的大幅滚动；是否触发取决于输入框当时的绝对位置，表现为偶发。
             adjustResize 下 WebView 内建 IME insets 处理生效（edge-to-edge 时窗口 frame 不变，
             由 WebView 消化 insets），可视区正确，实测打字全程零滚动。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Zcodemobile"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="remote"
                    android:scheme="zcode" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="zcode.z.ai"
                    android:pathPrefix="/remote"
                    android:scheme="https" />
            </intent-filter>
        </activity>
    </application>

</manifest>
